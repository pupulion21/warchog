# Copy to .local/warchog-server.env and chmod 600 that file.
# Free online works without a signer. Enable prize entry only with the
# result signer registered in the deployed escrow; never use a VITE_* key.
WARCHOG_PAYMENTS_ENABLED=false
WARCHOG_SIGNER_PRIVATE_KEY=
WARCHOG_DB_PATH=.local/warchog.sqlite
WARCHOG_ROUND_SECONDS=180
# Comma-separated additional trusted browser origins, if required:
# WARCHOG_ORIGINS=https://your-game.example
# Standalone listener variables must be exported in the process environment:
# WARCHOG_HOST=127.0.0.1
# WARCHOG_PORT=5190
